# Copy this file to .env before starting the lab:   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# On Linux, set AIRFLOW_UID to your own user id:    echo "AIRFLOW_UID=$(id -u)" > .env
AIRFLOW_UID=50000

# --- SMTP settings ---
# Default (all lines below commented out): emails go to the local Mailpit container, UI at http://localhost:8025
# To send through Gmail, uncomment these and replace the placeholders, then run: docker compose up -d
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_address@gmail.com
# SMTP_PASSWORD=your_16_letter_app_password
# SMTP_DISABLE_SSL=true
# SMTP_DISABLE_TLS=false
# SMTP_FROM=your_address@gmail.com
