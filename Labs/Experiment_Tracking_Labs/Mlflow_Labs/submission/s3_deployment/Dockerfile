# Serves ONE registered model version, baked into the image (immutable: image tag = model version).
# Build context is generated by docker_build.py: build/v<N>/{Dockerfile, model/}.
#
# Layer order matters: the requirements layer changes rarely, the model layer changes every
# release. Copying requirements.txt FIRST means a new model version with the same dependencies
# rebuilds only the last layers instead of re-installing everything.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MLFLOW_DISABLE_AGENT_HINT=1

# Only set for models that need torch: the default Linux torch wheel drags in ~GBs of CUDA libraries.
ARG PIP_EXTRA_INDEX=""

WORKDIR /opt/model
COPY model/requirements.txt /opt/model/requirements.txt
RUN pip install -r /opt/model/requirements.txt ${PIP_EXTRA_INDEX:+--extra-index-url ${PIP_EXTRA_INDEX}}

COPY model/ /opt/model/

# Do not run a network service as root.
RUN useradd --no-create-home --uid 10001 app && chown -R app /opt/model
USER app

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=60s --retries=3 \
  CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2).status == 200 else 1)"

# --env-manager local: the image IS the environment; do not build another one at startup.
CMD ["mlflow", "models", "serve", "-m", "/opt/model", "-h", "0.0.0.0", "-p", "8080", "--env-manager", "local"]
