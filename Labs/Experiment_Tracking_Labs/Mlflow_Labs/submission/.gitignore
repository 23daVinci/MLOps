# NOTE: git does not allow comments after a pattern on the same line; keep comments on their own lines.

# --- Python environment and caches ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- MLflow state (regenerated by running the scripts; the db also stores your OS username) ---
mlflow.db
mlartifacts/
mlruns/

# --- Generated at runtime ---
# batch inputs/outputs. The dataset itself (data/adult.csv, 5 MB, UCI Adult, CC BY 4.0) IS committed so
# the lab runs offline; without it the first run downloads it from OpenML.
data/*
!data/adult.csv
# server logs and pid files
logs/
# generated reports
reports/
# Docker build context
build/
ops/.server.pid

# --- Secrets: never commit these ---
.env
.env.*
*.pem
*.key
credentials*.json

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
